
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y

# FATFS: UTF-8 filename encoding + Simplified Chinese codepage
# (required for Chinese filenames in /sdcard/music, /sdcard/records etc.)
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Console: USB-Serial/JTAG (board has no external UART bridge)
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# === BLE HID Host (Bluetooth keyboard input) ===
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_BONDING=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Use PSRAM for NimBLE heap to free internal RAM for audio/AFE.
# (workaround_bt_data.lf resolves the IDF 5.5.2 ldgen 'data' section bug
#  that previously blocked MEM_ALLOC_MODE_EXTERNAL.)
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# NimBLE host task on Core 0. Audio input task is pinned to Core 0 with
# priority 8 (> NimBLE), so audio is not starved; board tasks (SELFTEST,
# screenshot cmd) stay on Core 1. PSRAM handles the memory, so Core 0 is OK.
CONFIG_BT_NIMBLE_PINNED_TO_CORE=0
# === TLS/mbedTLS memory tuning (fix boot-time "发送失败") ===
# Hardware AES DMA staging buffer is proportional to SSL record size.
# 16384->8192 halves the internal MALLOC_CAP_DMA allocation needed during
# boot TLS handshake (which previously failed with ~20KB fragmented free).
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
# Fewer small allocations forced into internal RAM -> less DMA pool
# fragmentation (512->256).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
# Free peer certificate after handshake (saves ~1-2KB post-handshake).
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y

